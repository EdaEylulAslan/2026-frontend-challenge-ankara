# Copy to `.env` and replace with your Jotform API keys and form IDs from the hackathon brief.
VITE_JOTFORM_API_KEY_1=your_api_key_1
VITE_JOTFORM_API_KEY_2=your_api_key_2
VITE_JOTFORM_API_KEY_3=your_api_key_3

VITE_FORM_CHECKINS=your_form_id_checkins
VITE_FORM_MESSAGES=your_form_id_messages
VITE_FORM_SIGHTINGS=your_form_id_sightings
VITE_FORM_NOTES=your_form_id_notes
VITE_FORM_TIPS=your_form_id_tips
